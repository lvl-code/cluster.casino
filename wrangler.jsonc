{
  "name": "clustercasino",
  "main": "en/worker/index.js",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  
  "assets": {
    "binding": "ASSETS",
    "directory": "./en",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "clustercasino-db",
    "database_id": "73c5c49d-e70a-4270-a97e-db3ceefedc31"
 }],
  "ai": {
    "binding": "AI"
  },
  
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "18961fa2a8b844e9b717b9360d80dcf5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "level-casino-media"
    }
  ],

  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  }

}
